{
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "endOfLine": "lf",
  "sortImports": {
    "groups": ["builtin", "external", "internal", "parent", "sibling", "index"],
    "newlinesBetween": true,
    "ignoreCase": true,
    "order": "asc"
  }
}
